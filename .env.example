# --- Database (Supabase Postgres) ---
# Project Settings → Database → Connection string
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL — required
# for serverless/Vercel. Use the direct connection (port 5432) for DIRECT_URL
# — Prisma needs this one for running migrations.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Storage (Supabase) ---
# Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"   # server-only, never expose to the client

# --- Admin ---
# The shared password family members use to reach /admin
ADMIN_PASSWORD="choose-a-real-password-here"
